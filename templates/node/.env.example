# Copy to .env (never commit .env). The key and secret come from Settings → Developers → API keys in Power Apps.
INO_BASE_URL=https://api.inoloyalty.com/t/<tenant-code>
INO_CHANNEL={{channel}}
INO_API_KEY=
INO_HMAC_SECRET=
# The subscription secret shown once by `ino webhooks create` (whsec_…).
INO_WEBHOOK_SECRET=
PORT=8080
QUEUE_FILE=./data/queue.jsonl
